<!DOCTYPE html>
<html>
<head>
    <title>Student Marksheet</title>

    <style>

        body{
            font-family:Arial;
            background:#f2f2f2;
        }

        .box{
            width:700px;
            margin:auto;
            margin-top:50px;
            background:white;
            padding:20px;
            box-shadow:0px 0px 10px gray;
        }

        h2{
            text-align:center;
        }

        table{
            width:100%;
            border-collapse:collapse;
        }

        table,th,td{
            border:1px solid black;
        }

        th,td{
            padding:10px;
            text-align:center;
        }

    </style>

</head>

<body>

<div class="box">

<h2>Student Marksheet</h2>

<p><b>Name :</b> {{ student.name }}</p>
<p><b>Roll No :</b> {{ student.roll_no }}</p>

<table>

<tr>
<th>Subject</th>
<th>Marks</th>
</tr>

<tr>
<td>Python</td>
<td>{{ student.python }}</td>
</tr>

<tr>
<td>Java</td>
<td>{{ student.java }}</td>
</tr>

<tr>
<td>DBMS</td>
<td>{{ student.dbms }}</td>
</tr>

<tr>
<td>Django</td>
<td>{{ student.django }}</td>
</tr>

<tr>
<td>HTML</td>
<td>{{ student.html }}</td>
</tr>

<tr>
<th>Total</th>
<th>{{ student.total }}</th>
</tr>

<tr>
<th>Percentage</th>
<th>{{ student.percentage }}%</th>
</tr>

<tr>
<th>Grade</th>
<th>{{ student.grade }}</th>
</tr>

</table>

</div>

</body>
</html>
